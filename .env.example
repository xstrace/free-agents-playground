# ── agent 本体 ─────────────────────────────────────────────
# pi agent 安装方式(镜像构建时执行):
#   留空  -> 官方 npm 安装 (@earendil-works/pi-coding-agent, 推荐)
#   "stub" -> 占位桩(只测管线, 不回话)
#   其他  -> 自定义安装命令, 要求产出 /usr/local/bin/pi
PI_INSTALL=

# 拉起 pi 的命令(镜像内), 会在 WORKDIR=/workspace, 非 root 用户下执行
# 已带 -c: 容器重启后自动续接最近会话(不丢上下文)
# 免费模型实测: opencode/deepseek-v4-flash-free 最稳(需 OPENCODE_API_KEY)
#              openrouter 免费端点普遍限流, gemma-4-26b-a4b-it:free 相对可用
PI_CMD=/usr/local/bin/pi -c --model opencode/deepseek-v4-flash-free

# ── 模型 API key(pi 支持多家, 至少填一个) ──────────────────
# opencode zen 免费模型(推荐): https://opencode.ai/zen/keys
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ── 资源限制(收紧版) ────────────────────────────────────────
AGENT_CPUS=1
AGENT_MEM=1g
AGENT_PIDS=128
WORKSPACE_SIZE=10g        # /workspace: 10G ext4 loop 镜像(宿主 data/workspace.img), 硬上限
MEMORY_SIZE=64m           # /memory tmpfs(长期记忆, 计入 1G 内存)

# ── 循环驱动 ───────────────────────────────────────────────
# supervisor 每 5 分钟看一次: 上一轮结束(心跳超过 IDLE_DONE_SEC 秒没动静)
# 且距上次注入超过 LOOP_INTERVAL_SEC, 才注入下一轮提示词
LOOP_INTERVAL_SEC=300
IDLE_DONE_SEC=120
