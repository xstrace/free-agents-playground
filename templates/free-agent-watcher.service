[Unit]
Description=free-agents watcher (supervisor + metrics)
After=docker.service

[Service]
Type=simple
WorkingDirectory=/root/projects/free-agents-playground
ExecStart=/usr/bin/python3 watcher/supervisor.py
ExecStartPost=/bin/sh -c 'nohup /usr/bin/python3 watcher/metrics.py >> audit/metrics.daemon.log 2>&1 & echo $! > /run/fap-metrics.pid'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
